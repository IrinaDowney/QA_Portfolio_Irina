  "item": [
    {
      "name": "Create new address",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseJson = pm.response.json();\r",
              "\r",
              "// ============================================\r",
              "// STATUS CHECK\r",
              "// ============================================\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"Response time is less than 500ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});\r",
              "\r",
              "pm.test(\"Response Size is less than 2000B\", function () {\r",
              "    pm.expect(pm.response.responseSize).to.be.below(2000);\r",
              "});\r",
              "\r",
              "    // RESPONSE CHECKS\r",
              "    \r",
              "    pm.test(\"Response has id\", function () {\r",
              "        pm.expect(responseJson).to.have.property(\"id\");\r",
              "});\r",
              "        \r",
              "        pm.test(\"ID is not empty\", function () {\r",
              "            pm.expect(responseJson.id).to.not.be.empty;\r",
              "});\r",
              "\r",
              "pm.test(\"ID is valid UUID format\", function () {\r",
              "    const uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\r",
              "    pm.expect(responseJson.id).to.match(uuidPattern);\r",
              "});\r",
              "\r",
              "pm.test(\"Body matches string '{}'\", function () {\r",
              "    pm.expect(pm.response.text()).to.include(\"\");\r",
              "});\r",
              "\r",
              "// DEBUG\r",
              "console.log(\"Response ID:\", responseJson.id);\r",
              "console.log(\"Saved addressId:\", pm.environment.get(\"addressId\"));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"address\": {\r\n        \"fullName\": {\r\n            \"firstName\": \"{{FN}}\",\r\n            \"lastName\": \"{{LN}}\"\r\n        },\r\n        \"company\": \"{{COMPANY}}\",\r\n        \"taxInfo\": {\r\n            \"id\": null,\r\n            \"type\": null\r\n        },\r\n        \"addressLine1\": \"111 North Franklin Street\",\r\n        \"addressLine2\": null,\r\n        \"street\": {\r\n            \"name\": null,\r\n            \"number\": null\r\n        },\r\n        \"city\": \"Christiansburg\",\r\n        \"country\": \"USA\",\r\n        \"subdivision\": \"VA\",\r\n        \"zipCode\": \"24073\",\r\n        \"phoneNumber\": \"1234567890\",\r\n        \"location\": {\r\n            \"latitude\": 37.13158230000001,\r\n            \"longitude\": -80.41081129999999\r\n        }\r\n    },\r\n    \"setAsDefault\": false\r\n}",
