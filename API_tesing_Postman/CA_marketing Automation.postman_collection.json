    {
      "name": "Get_spec_address",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// ============================================\r",
              "// PARSE RESPONSE ONCE\r",
              "// ============================================\r",
              "\r",
              "const jsonData = pm.response.json(); // ✅ declared once, used everywhere\r",
              "\r",
              "// ============================================\r",
              "// STATUS CHECKS\r",
              "// ============================================\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is less than 500ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});\r",
              "\r",
              "pm.test(\"Response size is less than 2000B\", function () {\r",
              "    pm.expect(pm.response.responseSize).to.be.below(2000);\r",
              "});\r",
              "\r",
              "pm.test(\"Response body is not empty\", function () {\r",
              "    pm.expect(pm.response.text()).to.not.be.empty;\r",
              "});\r",
              "\r",
              "// ============================================\r",
              "// ID CHECK — top level not inside address\r",
              "// ============================================\r",
              "\r",
              "pm.test(\"ID is correct\", function () {\r",
              "    pm.expect(jsonData.id).to.eql(pm.environment.get(\"addressId\")); // ✅ top level id\r",
              "});\r",
              "\r",
              "// ============================================\r",
              "// ALL VALUES CHECK\r",
              "// ============================================\r",
              "\r",
              "pm.test(\"Full name is correct\", function () {\r",
              "    pm.expect(jsonData.address.fullName.firstName).to.eql(pm.environment.get(\"FN\"));\r",
              "    pm.expect(jsonData.address.fullName.lastName).to.eql(pm.environment.get(\"LN\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Address details are correct\", function () {\r",
              "    pm.expect(jsonData.address.country).to.eql(\"USA\");\r",
              "    pm.expect(jsonData.address.subdivision).to.eql(\"VA\");\r",
              "    pm.expect(jsonData.address.city).to.eql(\"Christiansburg\");\r",
              "    pm.expect(jsonData.address.zipCode).to.eql(\"24073\");\r",
              "    pm.expect(jsonData.address.addressLine1).to.eql(\"111 North Franklin Street\");\r",
              "});\r",
              "\r",
              "pm.test(\"Phone and company are correct\", function () {\r",
              "    pm.expect(jsonData.address.phoneNumber).to.eql(\"1234567890\");\r",
              "    pm.expect(jsonData.address.company).to.eql(pm.environment.get(\"COMPANY\"));\r",
              "});\r",
              "\r",
              "console.log(\"Response ID:\", jsonData.id);\r",
              "console.log(\"Environment addressId:\", pm.environment.get(\"addressId\"));\r",
              "\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
